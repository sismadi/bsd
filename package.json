{
  "name": "basadi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute basadi-db --remote --file=schema.sql",
    "db:seed": "wrangler d1 execute basadi-db --remote --file=seed.sql",
    "db:local": "wrangler d1 execute basadi-db --local --file=schema.sql && wrangler d1 execute basadi-db --local --file=seed.sql"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
